{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/judge.ts": {
      "includeFiles": "node_modules/pyodide/**",
      "maxDuration": 20
    }
  },
  "rewrites": [
    { "source": "/courses/:path*", "destination": "/index.html" },
    { "source": "/problems/:path*", "destination": "/index.html" },
    { "source": "/practice/:path*", "destination": "/index.html" },
    { "source": "/progress", "destination": "/index.html" },
    { "source": "/concepts/:path*", "destination": "/index.html" },
    { "source": "/typing/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(models|pyodide|voice-packs)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
